{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "Web": {
      "Key": "EasyOneService_Local_Development_Jwt_Key_2026_Keep_Long",
      "Issuer": "MyApi",
      "Audience": "MyApiUsers.Web",
      "TokenValidityInMinutes": 15,
      "RefreshTokenValidityInDays": 3
    },
    "Mobile": {
      "Issuer": "MyApi",
      "Audience": "MyApiUsers.Mobile",
      "TokenValidityInMinutes": 30,
      "RefreshTokenValidityInDays": 14
    },
    "Windows": {
      "Issuer": "MyApi",
      "Audience": "MyApiUsers.Windows",
      "TokenValidityInMinutes": 600,
      "RefreshTokenValidityInDays": 14
    }
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  },

  "AllowedHosts": "*"
}
